<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form</title>
</head>
<body>
    <form method="POST" action="/new">
        <h1>New Message</h1>

        <div>
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" placeholder="e.g. Abdullah">
        </div>  
        
        <div>
            <label for="message">Message:</label>
            <textarea name="message" id="message" placeholder="e.g. Good Morning!"></textarea>
        </div> 

        <button type="submit">Add</button>
    </form>
</body>
</html>