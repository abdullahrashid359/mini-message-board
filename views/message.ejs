<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Details</title>
</head>
<body>
    <main>
        <article>
            <header>
                <h1><%= message.user %></h1>
                <time><%= message.added.toLocaleString('en-US', { 
                        year: 'numeric' ,
                        month: 'long' ,
                        day: 'numeric' ,
                        hour: 'numeric' , 
                        minute: '2-digit' 
                    }) %>
                </time>
            </header>

            <p><%= message.text %></p>
        </article>

        <a href="/">Back to Message Board</a>
    </main>
</body>
</html>