<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message | Spill</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <%- include('partials/navbar') %>

        <main class="main">
            <article class="message-detail">
                <header class="message-detail-header">
                    <h1>
                        <%= message.user %>
                    </h1>

                    <time>
                        <%= message.added.toLocaleString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' ,
                            hour: 'numeric' , minute: '2-digit' }) %>
                    </time>
                </header>

                <p>
                    <%= message.text %>
                </p>

                <a href="/">← Back to Spill</a>
            </article>
        </main>
</body>

</html>