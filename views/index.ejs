<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Board</title>
</head>
<body>
    <h1><%= title %></h1>
    <p>Welcome to the message board!</p>
    <a href="/new">Add a new message</a>
    <% messages.forEach(message => { %>
        <article>
            <header>
                <h2><%= message.user %></h2>
                <time><%= message.added %></time>
            </header>

            <p><%= message.text %></p>
        </article>
    <% }); %> 
</body>
</html>